#!/usr/bin/env python3
"""Stand-in for fleet-change in supervisor tests: records each call (one line, the arguments
joined by spaces) in $FAKE_FLEET_CHANGE_LOG and answers like the real one would for
`submit` (received) and `finish` (the outcome it was given)."""
import json
import os
import sys

log = os.environ.get("FAKE_FLEET_CHANGE_LOG")
if log:
    os.makedirs(os.path.dirname(log), exist_ok=True)
    with open(log, "a") as f:
        f.write(" ".join(sys.argv[1:]) + "\n")
args = sys.argv[1:]
if args[:1] == ["submit"]:
    rid = args[args.index("--id") + 1] if "--id" in args else "x"
    print(json.dumps({"id": rid, "state": "received"}))
elif args[:1] == ["finish"] and len(args) >= 3:
    print(json.dumps({"id": args[1], "state": args[2]}))
elif args[:1] == ["hold-lock"]:
    import time
    print("held", flush=True)
    while True:
        time.sleep(1)
sys.exit(int(os.environ.get("FAKE_FLEET_CHANGE_RC", "0")))
