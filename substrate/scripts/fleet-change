#!/usr/bin/env python3
"""fleet-change — the machine's front door for changes to fleet state.

Canonical copy lives in the app's source repo at substrate/scripts/fleet-change
and is distributed to every managed host by the fleet-substrate distributor
(src/backend/distributor/catalog.ts). Installed per-box at
~/.local/bin/fleet-change. Do NOT hand-edit the installed copy.

Every change to projects and apps goes through here, whoever asks: the app's
server (over the SSH connection it already holds, or the bind mount on its own
machine) and agents on the machine run the same command. Requests are written
down before anything happens, numbered in arrival order, and carried out one
at a time by the listener (`fleet-change serve`, run by fleet-changes.service).
While a request runs the listener holds ~/fleet/.change-lock; the
agent-supervisor takes the same lock for each change its own pass makes, so a
request and the supervisor never touch things at the same moment.

Usage:
  fleet-change submit <kind> <args-json> [--id <id>] [--wait <sec>]
  fleet-change status <id> [--wait <sec>]
  fleet-change serve [--until-idle]
  fleet-change kinds
  fleet-change hold-lock --parent <pid>
  fleet-change finish <id> done|refused|failed [--code <c>] [--reason <r>] [--result <json>]

  submit   send a request and wait up to --wait seconds (default 15) for its
           outcome. --id is chosen by the caller; sending the same id again
           never does the request twice, it just waits for (or returns) the
           first one's outcome. Without --id a random one is used.
  status   the outcome of an earlier request, waiting up to --wait (default 0).
  serve    run the listener (fleet-changes.service). One per machine.
           --until-idle stops once nothing is waiting (tests, manual runs).
  kinds    print the request kinds this machine understands, one JSON line.
  hold-lock  take the change lock, print "held", and keep it until killed or
           until <pid> exits. How the agent-supervisor (a shell script, which
           can't keep a lock out of the processes it starts) takes its turn.
  finish   write the outcome of a request that was finished in the background
           (an un-archive: the supervisor brings the agent back, then finishes it).

Output (submit / status): one JSON line on stdout.
  finished:  {"id","seq","kind","state":"done"|"refused"|"failed",
              "code"?,"reason"?,"result"?}
  not yet:   {"id","kind"?,"seq"?,"state":"received"|"queued"|"running",
              "ahead"?,"stage"?}
             "received" = written down but the listener hasn't taken it in yet.
             "stage":"finishing" = accepted, being finished in the background.
  An archive is done once it has claimed what it takes; while the supervisor
  is still finishing that, a done outcome carries
  "finishing": {"pending": [names], "stuck"?: {name: reason}} ("stuck" =
  failing for 10 minutes or more; it is still being retried).
  unknown:   {"id","state":"unknown"}  (status only: never seen, or pruned)
Exit status: 0 for any of the above, 2 for usage errors (message on stderr).

Request kinds:
  app-move          {"slug", "to":"sidebar", "users":[...]|null}
                    {"slug", "to":"project", "project":"<slug>"}
  project-contents  {"slug"}  what archiving it would take, as the machine sees it
  project-archive   {"slug", "expected":{"projects":[...],"agents":[...],"apps":[...]}}
                    refused with code contents_changed (and the current
                    contents as result) when the machine's contents no longer
                    match what the user confirmed. Its agents are claimed.
  agent-archive     {"name", "dormant"?: true, "idleFor"?: <s>, "by"?: "agent"|"scheduled"}
                    claims the agent (.archiving in its folder): from then on it's
                    gone from every list, never launched, and stopped; the
                    supervisor finishes the archive in the background.
                    "dormant" = the 180-day sleep sweep (its guards are checked,
                    and it must still have been idle for idleFor seconds).
  agent-unarchive   {"name"}  quick checks, then handed to the supervisor, which
                    brings the chat account and the folder back and finishes the
                    request. Waits for an archive of the same agent to finish.
  role-contents     {"name"}  the agents archiving the role would take
  role-archive      {"name", "expected"?: {"agents": [...]}}  claims the role and
                    its agents (contents_changed as for projects). Without
                    "expected" (a note left by an agent) it takes who holds it.
  role-unarchive    {"name"}
  app-archive       {"slug"}  a sidebar app (archive-app.sh)
  app-unarchive     {"slug"}  back into the sidebar on its old port

On disk, all under ~/fleet/.changes/:
  incoming/<ns>-<id>.json   a request as written by submit (atomic rename)
  journal/<seq>-<id>.json   taken in by the listener and numbered; removed
                            once its outcome is written
  outcomes/<id>.json        the outcome, kept for OUTCOME_KEEP_S
  background/<id>.json      a request handed to the supervisor to finish
  returning/<name>.json     an agent un-archive under way: {"name","ids":[...]}
  next-seq                  the next request number
  .serve.lock               held by the one running listener

A request left running when the listener stopped is carried on when it starts
again, from where its plan says it got to. Stdlib only; Python 3.8+.
"""
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
import uuid

FLEET = os.environ.get("FLEET_CHANGE_FLEET_DIR") or os.path.join(os.path.expanduser("~"), "fleet")
ROOT = os.path.join(FLEET, ".changes")
INCOMING = os.path.join(ROOT, "incoming")
JOURNAL = os.path.join(ROOT, "journal")
OUTCOMES = os.path.join(ROOT, "outcomes")
SEQ_FILE = os.path.join(ROOT, "next-seq")
SERVE_LOCK = os.path.join(ROOT, ".serve.lock")
CHANGE_LOCK = os.environ.get("FLEET_CHANGE_LOCK") or os.path.join(FLEET, ".change-lock")
CREATE_LOCK = os.path.join(FLEET, ".create-lock")
PROJECTS = os.path.join(FLEET, "projects")
PROJECTS_ARCHIVE = os.path.join(PROJECTS, "archive")
IDENTITIES = os.path.join(FLEET, "identities")
IDENTITIES_ARCHIVE = os.path.join(FLEET, "identities-archive")
ROLES = os.path.join(FLEET, "roles")
ROLES_ARCHIVE = os.path.join(FLEET, "roles-archive")
APPS = os.path.join(FLEET, "apps")
APPS_ARCHIVE = os.path.join(FLEET, "apps-archive")
BACKGROUND = os.path.join(ROOT, "background")
RETURNING = os.path.join(ROOT, "returning")
SKILL_DIR = os.path.join(os.path.expanduser("~"), ".claude", "skills", "app-development")
APP_UNITS = os.environ.get("FLEET_CHANGE_APP_UNITS") or os.path.join(SKILL_DIR, "app-units.sh")
MOVE_APP = os.environ.get("FLEET_CHANGE_MOVE_APP") or os.path.join(SKILL_DIR, "move-app.sh")
ARCHIVE_APP = os.environ.get("FLEET_CHANGE_ARCHIVE_APP") or os.path.join(SKILL_DIR, "archive-app.sh")
UNIT_DIR = os.environ.get("FLEET_CHANGE_UNIT_DIR") or os.path.join(os.path.expanduser("~"), ".config", "systemd", "user")
SYSTEMCTL = os.environ.get("FLEET_CHANGE_SYSTEMCTL") or "systemctl"
# An agent or role whose archive has been claimed carries this; the supervisor finishes the
# archive in the background and the mark goes into the archive with the folder.
CLAIM = ".archiving"
# Touched (renamed into place) to end the supervisor's between-pass wait early.
SUPERVISOR_WAKE = os.path.join(IDENTITIES, ".supervisor-wake")
STUCK_AFTER_S = 600

POLL_S = float(os.environ.get("FLEET_CHANGE_POLL_S", "0.1"))
OUTCOME_KEEP_S = 7 * 24 * 3600
PRUNE_EVERY_S = 600
LOCK_WAIT_WARN_S = 30
DEFAULT_WAIT_S = 15.0
MAX_WAIT_S = 600.0

ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,80}$")
SLUG_RE = re.compile(r"^[a-z0-9-]{1,64}$")
NAME_RE = re.compile(r"^[a-z0-9_-]{1,64}$")
ROLE_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
APP_SLUG_RE = re.compile(r"^[a-z][a-z0-9-]*$")
USER_RE = re.compile(r"^[^,\s]+$")
KINDS = ("app-move", "project-contents", "project-archive", "agent-archive", "agent-unarchive",
         "role-contents", "role-archive", "role-unarchive", "app-archive", "app-unarchive")


def log(msg):
    print(time.strftime("%H:%M:%S") + " " + msg, flush=True)


def ensure_dirs():
    for d in (ROOT, INCOMING, JOURNAL, OUTCOMES, BACKGROUND, RETURNING):
        os.makedirs(d, exist_ok=True)


def write_json_atomic(path, obj):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, separators=(",", ":"))
        f.write("\n")
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def list_json(d):
    try:
        return sorted(n for n in os.listdir(d) if n.endswith(".json") and ".tmp." not in n)
    except OSError:
        return []


def id_of(name):
    """<prefix>-<id>.json → id (ids may themselves contain '-')."""
    return name[:-5].split("-", 1)[1] if "-" in name else None


class Lock:
    """An exclusive flock on a file, opened close-on-exec so children never hold it."""

    def __init__(self, path, what):
        self.path, self.what, self.fd = path, what, None

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
        start = time.time()
        warned = False
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if not warned and time.time() - start > LOCK_WAIT_WARN_S:
                    log("WARN: still waiting for %s (%s) after %ds" % (self.what, self.path, LOCK_WAIT_WARN_S))
                    warned = True
                time.sleep(0.05)

    def __exit__(self, *exc):
        try:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
        finally:
            os.close(self.fd)
            self.fd = None


# ---------------------------------------------------------------------------
# Reading the machine
# ---------------------------------------------------------------------------

def frontmatter(path, cap=65536):
    """Top-level `key: value` pairs of a markdown file's leading --- block."""
    try:
        with open(path, encoding="utf-8-sig") as f:
            text = f.read(cap)
    except OSError:
        return None
    lines = text.splitlines()
    if not lines or lines[0].rstrip() != "---":
        return {}
    out = {}
    for ln in lines[1:]:
        if ln.rstrip() == "---":
            break
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*?)\s*$", ln)
        if not m:
            continue
        v = m.group(2)
        if v and v[0] in "\"'" and v[-1:] == v[0] and len(v) >= 2:
            v = v[1:-1]
        else:
            v = re.sub(r"\s+#.*$", "", v)
        out[m.group(1)] = v
    return out


def live_projects():
    """slug → {"slug","displayName","parent"} for every live project."""
    out = {}
    try:
        names = os.listdir(PROJECTS)
    except OSError:
        return out
    for slug in names:
        if slug == "archive" or not SLUG_RE.match(slug):
            continue
        fm = frontmatter(os.path.join(PROJECTS, slug, "project.md"))
        if fm is None:
            continue
        parent = fm.get("parent") or None
        if parent is not None and not SLUG_RE.match(parent):
            parent = None
        out[slug] = {"slug": slug, "displayName": fm.get("displayName") or slug, "parent": parent}
    return out


def subtree(projects, slug):
    """slug and every project beneath it, parent first."""
    order, seen, frontier = [slug], {slug}, [slug]
    while frontier:
        nxt = []
        for p in sorted(projects):
            if p not in seen and projects[p]["parent"] in frontier:
                seen.add(p)
                order.append(p)
                nxt.append(p)
        frontier = nxt
    return order


def app_title(app_dir, slug):
    card = read_json(os.path.join(app_dir, "app.json"))
    if isinstance(card, dict) and isinstance(card.get("title"), str) and card["title"].strip():
        return card["title"].strip()
    return slug


def project_contents(slug):
    """What archiving `slug` takes right now, or None when it isn't a live project."""
    projects = live_projects()
    if slug not in projects:
        return None
    tree = subtree(projects, slug)
    in_tree = set(tree)
    agents = []
    try:
        names = sorted(os.listdir(IDENTITIES))
    except OSError:
        names = []
    for name in names:
        fm = frontmatter(os.path.join(IDENTITIES, name, name + ".md"))
        if fm and fm.get("project") in in_tree and not agent_claimed(name):
            agents.append({
                "name": name,
                "displayName": fm.get("displayName") or name,
                "task": fm.get("task") or "",
                "project": fm["project"],
            })
    apps = []
    for p in tree:
        apps_dir = os.path.join(PROJECTS, p, "apps")
        try:
            slugs = sorted(os.listdir(apps_dir))
        except OSError:
            continue
        for a in slugs:
            d = os.path.join(apps_dir, a)
            if APP_SLUG_RE.match(a) and os.path.isdir(d):
                apps.append({"slug": a, "title": app_title(d, a), "project": p})
    return {
        "project": slug,
        "projects": [projects[p] for p in tree],
        "agents": agents,
        "apps": apps,
    }


def contents_key(c):
    return (
        sorted(p["slug"] if isinstance(p, dict) else p for p in c.get("projects", [])),
        sorted(a["name"] if isinstance(a, dict) else a for a in c.get("agents", [])),
        sorted(a["slug"] if isinstance(a, dict) else a for a in c.get("apps", [])),
    )


def archived_project_dir(slug):
    """An archived copy of `slug` (plain or collision-suffixed), or None."""
    try:
        names = os.listdir(PROJECTS_ARCHIVE)
    except OSError:
        return None
    pat = re.compile(r"^%s(-\d{8}T\d{6}Z)?$" % re.escape(slug))
    for n in sorted(names, reverse=True):
        if pat.match(n) and os.path.isdir(os.path.join(PROJECTS_ARCHIVE, n)):
            return n
    return None


def project_label(slug):
    fm = frontmatter(os.path.join(PROJECTS, slug, "project.md"))
    if fm is None:
        d = archived_project_dir(slug)
        fm = frontmatter(os.path.join(PROJECTS_ARCHIVE, d, "project.md")) if d else None
    return (fm or {}).get("displayName") or slug


def fm_roles(path):
    """The roles an agent file's frontmatter names (`roles: [a, b]`, `roles: a` or a block list)."""
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as f:
            lines = f.read(65536).replace("\r\n", "\n").split("\n")
    except OSError:
        return []
    if not lines or lines[0].strip() != "---":
        return []
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        return []

    def clean(v):
        return re.sub(r"\s+#.*$", "", v).strip().strip("\"'").strip()

    raw = []
    for i in range(1, end):
        m = re.match(r"^roles:(.*)$", lines[i])
        if not m:
            continue
        inline = re.sub(r"(^|\s)#.*$", "", m.group(1)).strip()
        if inline in ("~", "null", "Null", "NULL"):
            break
        if inline:
            if inline.startswith("[") and inline.endswith("]"):
                inline = inline[1:-1]
            raw = [clean(v) for v in inline.split(",")]
        else:
            for j in range(i + 1, end):
                t = lines[j].strip()
                if not t or t.startswith("#"):
                    continue
                m2 = re.match(r"^-\s*(.*)$", t)
                if not m2:
                    break
                raw.append(clean(m2.group(1)))
        break
    out = []
    for r in raw:
        if r and ROLE_RE.match(r) and r not in out:
            out.append(r)
    return out


def claim_of(path):
    """The claim mark in a folder, as a dict, or None when there is none."""
    if not os.path.exists(os.path.join(path, CLAIM)):
        return None
    c = read_json(os.path.join(path, CLAIM))
    return c if isinstance(c, dict) else {}


def agent_claimed(name):
    return claim_of(os.path.join(IDENTITIES, name)) is not None


def live_agent(name):
    """A live agent whose archive hasn't been claimed."""
    return os.path.isfile(os.path.join(IDENTITIES, name, name + ".md")) and not agent_claimed(name)


def agent_card(name, fm):
    return {"name": name, "displayName": fm.get("displayName") or name, "task": fm.get("task") or ""}


def claim(path, rid, by, extra=None):
    """Mark a folder as being archived. A folder already claimed keeps its first claim."""
    if claim_of(path) is not None:
        return False
    mark = {"id": rid, "by": by, "claimed_at": time.time()}
    mark.update(extra or {})
    write_json_atomic(os.path.join(path, CLAIM), mark)
    try:
        os.unlink(os.path.join(path, ".archive-requested"))
    except OSError:
        pass
    return True


def wake_supervisor():
    """End the supervisor's wait so it starts on what was claimed now, not up to 15s later."""
    try:
        tmp = "%s.tmp.%d" % (SUPERVISOR_WAKE, os.getpid())
        with open(tmp, "w") as f:
            f.write("%f\n" % time.time())
        os.replace(tmp, SUPERVISOR_WAKE)
    except OSError:
        pass


def returning(name):
    """The un-archive under way for `name`, or None."""
    r = read_json(os.path.join(RETURNING, name + ".json"))
    return r if isinstance(r, dict) else None


def returning_roles(name):
    """The roles of an agent being un-archived (from wherever its folder is right now)."""
    for d in (os.path.join(IDENTITIES_ARCHIVE, name), os.path.join(IDENTITIES, name)):
        if os.path.isfile(os.path.join(d, name + ".md")):
            return fm_roles(os.path.join(d, name + ".md"))
    return []


def role_contents(name):
    """Who archiving the role `name` takes right now, or None when it isn't a live role."""
    d = os.path.join(ROLES, name)
    if not os.path.isdir(d) or claim_of(d) is not None:
        return None
    fm = frontmatter(os.path.join(d, name + ".md")) or {}
    agents = []
    try:
        names = sorted(os.listdir(IDENTITIES))
    except OSError:
        names = []
    for a in names:
        path = os.path.join(IDENTITIES, a, a + ".md")
        if NAME_RE.match(a) and live_agent(a) and name in fm_roles(path):
            agents.append(agent_card(a, frontmatter(path) or {}))
    return {"role": name, "displayName": fm.get("displayName") or name, "agents": agents}


def finishing(names, role=None):
    """Of the agents (and role) an archive claimed, the ones whose clean-up isn't finished, and
    the reasons of those that have been failing for a while."""
    pending, stuck = [], {}
    targets = [(n, os.path.join(IDENTITIES, n)) for n in names]
    if role:
        targets.append((role, os.path.join(ROLES, role)))
    for n, d in targets:
        c = claim_of(d)
        if c is None:
            continue
        pending.append(n)
        since = c.get("failing_since")
        if isinstance(since, (int, float)) and time.time() - since >= STUCK_AFTER_S and c.get("last_error"):
            stuck[n] = c["last_error"]
    if not pending:
        return None
    out = {"pending": pending}
    if stuck:
        out["stuck"] = stuck
    return out


def run(argv, timeout=60):
    """Run a helper; one that runs out of time gets SIGTERM (so its own rollback runs), then SIGKILL."""
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        return 127, str(e)
    try:
        out, _ = p.communicate(timeout=timeout)
        return p.returncode, out.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGTERM)
            out, _ = p.communicate(timeout=10)
        except (subprocess.TimeoutExpired, ProcessLookupError):
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            out, _ = p.communicate()
        return 124, out.decode("utf-8", "replace") + "\ntimed out after %ds" % timeout


class Refused(Exception):
    def __init__(self, code, reason, result=None):
        super().__init__(reason)
        self.code, self.reason, self.result = code, reason, result


class Failed(Exception):
    def __init__(self, code, reason):
        super().__init__(reason)
        self.code, self.reason = code, reason


class HandedOff(Exception):
    """The request was accepted and is being finished in the background (by the supervisor),
    which writes its outcome with `fleet-change finish`. Until then it reads as running."""


# ---------------------------------------------------------------------------
# Request kinds — each runs under the change lock. `entry` is the journal
# entry; a handler may save progress into entry["plan"] via save_plan so a
# restart carries on instead of starting over.
# ---------------------------------------------------------------------------

def do_project_contents(args, entry, save_plan):
    slug = args.get("slug")
    if not isinstance(slug, str) or not SLUG_RE.match(slug) or slug == "archive":
        raise Refused("bad_request", "slug must match [a-z0-9-]{1,64}")
    c = project_contents(slug)
    if c is None:
        raise Refused("not_found", "that project doesn't exist or is already archived")
    return c


def stop_project_app(slug, app_dir):
    """Stop an app that's being archived with its project; its units are kept in its folder.
    False when it wasn't running (nothing to stop)."""
    rc, out = run(["bash", APP_UNITS, "port", slug])
    if rc != 0 or not out.strip():
        return False
    rc, out = run(["bash", APP_UNITS, "stash", slug, app_dir])
    if rc != 0:
        raise Failed("app_stop_failed", "couldn't keep the units of the app '%s': %s" % (slug, out.strip()[-300:]))
    rc, out = run(["bash", APP_UNITS, "uninstall", slug])
    if rc != 0:
        raise Failed("app_stop_failed", "couldn't stop the app '%s': %s" % (slug, out.strip()[-300:]))
    log("project app '%s' stopped, units kept in %s" % (slug, app_dir))
    return True


def restart_project_app(slug, app_dir):
    rc, out = run(["bash", APP_UNITS, "restore", slug, app_dir])
    if rc != 0:
        log("WARN: project app '%s': couldn't start it again (%s) — run app-units.sh restore %s %s"
            % (slug, out.strip()[-200:], slug, app_dir))


def plan_extras(plan):
    """What appeared in the not-yet-archived part of a plan since it was made (agents, apps,
    sub-projects) — a request carried on after a restart must not take those unconfirmed."""
    projects = live_projects()
    remaining = {p for p in plan["projects"] if p in projects}
    extras = []
    for p, meta in projects.items():
        if meta["parent"] in remaining and p not in plan["projects"]:
            extras.append("the sub-project \"%s\"" % meta["displayName"])
    planned_apps = {a["slug"] for a in plan["apps"]}
    for p in remaining:
        try:
            names = os.listdir(os.path.join(PROJECTS, p, "apps"))
        except OSError:
            names = []
        extras += ["the app '%s'" % a for a in sorted(names) if APP_SLUG_RE.match(a) and a not in planned_apps]
    try:
        idents = sorted(os.listdir(IDENTITIES))
    except OSError:
        idents = []
    for name in idents:
        fm = frontmatter(os.path.join(IDENTITIES, name, name + ".md"))
        if fm and fm.get("project") in remaining and name not in plan["agents"] and not agent_claimed(name):
            extras.append("the agent '%s'" % name)
    return extras


def do_project_archive(args, entry, save_plan):
    slug = args.get("slug")
    if not isinstance(slug, str) or not SLUG_RE.match(slug) or slug == "archive":
        raise Refused("bad_request", "slug must match [a-z0-9-]{1,64}")
    # The create lock too, from the check to the last folder: an app created or moved by an
    # agent in the meantime would otherwise go into the archive unconfirmed.
    with Lock(CREATE_LOCK, "the app create lock"):
        plan = entry.get("plan")
        if plan is None:
            expected = args.get("expected")
            if not isinstance(expected, dict):
                raise Refused("bad_request", "expected (the contents the user confirmed) is required")
            current = project_contents(slug)
            if current is None:
                raise Refused("not_found", "that project doesn't exist or is already archived")
            if contents_key(current) != contents_key(expected):
                raise Refused("contents_changed",
                              "what's in \"%s\" changed since you looked; check the list again" % project_label(slug),
                              current)
            refuse_taken_agent_slots([a["name"] for a in current["agents"]])
            plan = {
                "projects": [p["slug"] for p in current["projects"]],
                "agents": [a["name"] for a in current["agents"]],
                "apps": [{"slug": a["slug"], "project": a["project"]} for a in current["apps"]],
                "stopped": [],
                "archivedAs": {},
            }
            save_plan(plan)
        else:
            log("project archive '%s': carrying on from where it stopped" % slug)
            plan.setdefault("stopped", [])
            extras = plan_extras(plan)
            if extras:
                raise Failed("changed_during_restart",
                             "the archive was cut off, and since then %s appeared in it; "
                             "nothing more was archived" % ", ".join(extras[:5]))
        return archive_by_plan(plan, save_plan, entry["id"], slug)


def archive_by_plan(plan, save_plan, rid, slug):
    # 1. Stop every app in the tree before any folder moves, so a failure here leaves the
    #    whole project as it was (the apps already stopped are started again).
    for app in plan["apps"]:
        d = os.path.join(PROJECTS, app["project"], "apps", app["slug"])
        if app["slug"] in plan["stopped"] or not os.path.isdir(d):
            continue
        try:
            if stop_project_app(app["slug"], d):
                plan["stopped"].append(app["slug"])
                save_plan(plan)
        except Failed:
            if not plan["archivedAs"]:
                for a in plan["apps"]:
                    if a["slug"] in plan["stopped"]:
                        restart_project_app(a["slug"], os.path.join(PROJECTS, a["project"], "apps", a["slug"]))
                plan["stopped"] = []
                save_plan(plan)
            raise

    # 2. Folders, deepest first, so a project is never archived with something live beneath it.
    os.makedirs(PROJECTS_ARCHIVE, exist_ok=True)
    for p in reversed(plan["projects"]):
        src = os.path.join(PROJECTS, p)
        if not os.path.isdir(src):
            continue
        name = p
        if os.path.exists(os.path.join(PROJECTS_ARCHIVE, name)):
            name = "%s-%s" % (p, time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()))
        try:
            if os.path.exists(os.path.join(PROJECTS_ARCHIVE, name)):
                raise OSError("an archived copy of '%s' is in the way" % p)
            os.rename(src, os.path.join(PROJECTS_ARCHIVE, name))
        except OSError as e:
            done = [q for q in reversed(plan["projects"]) if q in plan["archivedAs"]]
            raise Failed("archive_move_failed", "couldn't archive \"%s\" (%s)%s" % (
                project_label(p), e,
                "; already archived: %s" % ", ".join(done) if done else "; nothing was archived"))
        plan["archivedAs"][p] = name
        save_plan(plan)
        log("project '%s' archived as archive/%s" % (p, name))

    # 3. Its agents are claimed, as an agent archive claims one; the supervisor finishes them.
    claimed = []
    for name in plan["agents"]:
        d = os.path.join(IDENTITIES, name)
        if os.path.isfile(os.path.join(d, name + ".md")):
            claim(d, rid, "project:%s" % slug)
            claimed.append(name)
    if claimed:
        wake_supervisor()
    return {
        "projects": [{"slug": p, "archivedAs": plan["archivedAs"].get(p)} for p in plan["projects"]],
        "agents": plan["agents"],
        "apps": plan["apps"],
        "claimed": claimed,
    }


def find_app(slug):
    if not os.path.isfile(APP_UNITS):
        raise Failed("app_units_missing", "app-units.sh is missing on this machine")
    rc, out = run(["bash", APP_UNITS, "find", slug])
    path = out.strip().splitlines()[-1] if rc == 0 and out.strip() else ""
    return path or None


def archived_app_project(slug):
    """The archived project an app went into the archive with, or None."""
    try:
        names = sorted(os.listdir(PROJECTS_ARCHIVE))
    except OSError:
        return None
    for n in names:
        if os.path.isdir(os.path.join(PROJECTS_ARCHIVE, n, "apps", slug)):
            return n
    return None


def inbox_drop(owner, payload):
    inbox = os.path.join(IDENTITIES, owner, "inbox")
    os.makedirs(inbox, exist_ok=True)
    fname = "%s%03d-%s.msg" % (time.strftime("%Y%m%dT%H%M%S", time.gmtime()), int(time.time() * 1000) % 1000,
                               os.urandom(4).hex())
    tmp = os.path.join(inbox, fname + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(payload)
    os.replace(tmp, os.path.join(inbox, fname))


def do_app_move(args, entry, save_plan):
    slug = args.get("slug")
    if not isinstance(slug, str) or not APP_SLUG_RE.match(slug) or len(slug) > 64:
        raise Refused("bad_request", "slug must match [a-z][a-z0-9-]*")
    to = args.get("to")
    if to == "sidebar":
        users = args.get("users")
        if users is None:
            argv, dest = ["sidebar", "--everyone"], os.path.join(APPS, slug)
        elif isinstance(users, list) and users and all(isinstance(u, str) and USER_RE.match(u) for u in users):
            argv, dest = ["sidebar", "--users", ",".join(users)], os.path.join(APPS, slug)
        else:
            raise Refused("bad_request", "users must be a list of usernames, or null for everyone")
        dest_label = "the sidebar"
    elif to == "project":
        project = args.get("project")
        if not isinstance(project, str) or not SLUG_RE.match(project) or project == "archive":
            raise Refused("bad_request", "project must match [a-z0-9-]{1,64}")
        argv, dest = ["project", project], os.path.join(PROJECTS, project, "apps", slug)
        dest_label = "the project '%s'" % project
    else:
        raise Refused("bad_request", 'to must be "sidebar" or "project"')

    if to == "project" and not os.path.isfile(os.path.join(PROJECTS, args["project"], "project.md")):
        if archived_project_dir(args["project"]) is not None:
            raise Refused("project_archived", "\"%s\" is archived" % project_label(args["project"]))
        raise Refused("project_not_found", "there's no project '%s' on this machine" % args["project"])
    src = find_app(slug)
    if src is None:
        gone_with = archived_app_project(slug)
        if gone_with is not None:
            raise Refused("archived", "it was archived with the project \"%s\"" % project_label(gone_with))
        if os.path.isdir(os.path.join(APPS_ARCHIVE, slug)):
            raise Refused("archived", "it's archived")
        raise Refused("not_found", "there's no app '%s' on this machine" % slug)
    plan = entry.get("plan") or {}
    if os.path.realpath(src) == os.path.realpath(dest):
        # Already there — nothing to do, or an earlier run of this request got the folder
        # there. One cut off before it reinstalled the app's units is finished now.
        port = plan.get("port")
        if port:
            rc, out = run(["bash", APP_UNITS, "port", slug])
            if rc != 0 or not out.strip():
                rc, out = run(["bash", APP_UNITS, "install", slug, dest, str(port)], timeout=60)
                if rc != 0:
                    raise Failed("move_failed", "it's in its new place but couldn't be started there: %s"
                                 % out.strip()[-200:])
                log("app '%s' move: carried on — started it in its new place on port %s" % (slug, port))
        return {"slug": slug, "to": to, "path": dest, "alreadyThere": True}

    owner = None
    rel = os.path.relpath(src, IDENTITIES)
    if not rel.startswith(".."):
        owner = rel.split(os.sep, 1)[0]
        if agent_claimed(owner):
            raise Refused("being_archived", "its conversation is being archived")
    title = app_title(src, slug)
    # Its port, kept with the request: if this is cut off midway, carrying on can finish it.
    rc, out = run(["bash", APP_UNITS, "port", slug])
    if rc == 0 and out.strip().isdigit():
        save_plan({"port": int(out.strip())})
    # Under the listener's stop timeout, so a stop never cuts move-app.sh off without its rollback.
    rc, out = run(["bash", MOVE_APP, slug] + argv, timeout=90)
    for line in out.splitlines():
        if line.strip():
            log("  move-app.sh[%s]: %s" % (slug, line))
    if rc != 0:
        tail = [ln for ln in out.splitlines() if ln.strip()][-3:]
        reason = re.sub(r"^\[move-app\] (ERROR: )?", "", tail[-1]) if tail else "move-app.sh failed (%d)" % rc
        raise Failed("move_failed", reason)
    if owner and os.path.isdir(os.path.join(IDENTITIES, owner)):
        safe_title = re.sub(r"[<>\r\n]", " ", title)[:120]
        try:
            inbox_drop(owner, (
                "<task-notification>\n<summary>App moved — delivered by the app</summary>\n"
                "<event>[app %s] Your conversation app \"%s\" was moved to %s from its menu. It is no longer "
                "one of your conversation apps; its address and data are unchanged. Nothing for you to do."
                "</event>\n</task-notification>") % (slug, safe_title, dest_label))
        except OSError as e:
            log("WARN: app '%s' move: couldn't tell '%s' its app moved: %s" % (slug, owner, e))
    return {"slug": slug, "to": to, "path": dest}


def check_name(args, key="name", pattern=NAME_RE, what="name"):
    v = args.get(key)
    if not isinstance(v, str) or not pattern.match(v):
        raise Refused("bad_request", "%s must match %s" % (what, pattern.pattern.strip("^$")))
    return v


def refuse_taken_agent_slots(names):
    """An archive that takes several agents is refused, before anything is claimed, when any of
    them has an archived agent of the same name in the way (its archive could never finish)."""
    taken = [n for n in names if os.path.exists(os.path.join(IDENTITIES_ARCHIVE, n))]
    if taken:
        raise Refused("archive_slot_taken", "an archived agent named '%s' is already in the archive; "
                      "nothing was archived" % taken[0])


def do_agent_archive(args, entry, save_plan):
    name = check_name(args)
    d = os.path.join(IDENTITIES, name)
    if agent_claimed(name):
        return {"name": name, "claimed": [name], "already": True}
    if returning(name) is not None:
        raise Refused("returning", "it's still being un-archived; try again in a minute")
    if not os.path.isfile(os.path.join(d, name + ".md")):
        if os.path.isdir(os.path.join(IDENTITIES_ARCHIVE, name)):
            return {"name": name, "claimed": [], "alreadyArchived": True}
        raise Refused("not_found", "there's no agent '%s' on this machine" % name)
    by = "user"
    if args.get("dormant") is True:
        # The 180-day sleep sweep: its guards are checked again now, not when it looked —
        # including how long it has been idle (it may have woken while this waited its turn).
        by = "dormant"
        fm = frontmatter(os.path.join(d, name + ".md")) or {}
        if os.path.exists(os.path.join(d, ".pinned")) or os.path.exists(os.path.join(d, ".no-dormancy")) \
                or str(fm.get("coordinator", "")).lower() == "true":
            raise Refused("guarded", "it's pinned, always-on or a coordinator")
        idle_for = args.get("idleFor")
        if not isinstance(idle_for, (int, float)) or idle_for <= 0:
            raise Refused("bad_request", "idleFor (seconds) is required with dormant")
        cursor = os.path.join(d, "relay-state", "since")
        try:
            fresh = os.stat(cursor if os.path.exists(cursor) else d).st_mtime
        except OSError:
            fresh = 0
        if time.time() - fresh < idle_for:
            raise Refused("not_idle", "it has been active since the sleep sweep looked")
    elif args.get("by") in ("agent", "scheduled"):
        by = args["by"]
    if os.path.exists(os.path.join(IDENTITIES_ARCHIVE, name)):
        raise Refused("archive_slot_taken", "an archived agent named '%s' is already in the archive" % name)
    claim(d, entry["id"], by)
    wake_supervisor()
    log("agent '%s' archive claimed (%s); the supervisor finishes it" % (name, by))
    return {"name": name, "claimed": [name]}


def do_agent_unarchive(args, entry, save_plan):
    name = check_name(args)
    live, arch = os.path.join(IDENTITIES, name), os.path.join(IDENTITIES_ARCHIVE, name)
    r = returning(name)
    if r is not None:
        # Already coming back: this request is answered with the same outcome.
        r.setdefault("ids", [])
        if entry["id"] not in r["ids"]:
            r["ids"].append(entry["id"])
            write_json_atomic(os.path.join(RETURNING, name + ".json"), r)
        raise HandedOff()
    still_archiving = agent_claimed(name)
    if os.path.isdir(live) and not still_archiving:
        if not os.path.isdir(arch):
            return {"name": name, "already": True}
        raise Refused("name_collision", "a live agent named '%s' already exists on this machine" % name)
    if not still_archiving and not os.path.isdir(arch):
        raise Refused("archive_not_found", "'%s' isn't in the archive" % name)
    md = os.path.join(live if still_archiving else arch, name + ".md")
    if not os.path.isfile(md):
        raise Refused("identity_unreadable", "the archived agent file %s.md is missing" % name)
    missing = [ro for ro in fm_roles(md) if not os.path.isdir(os.path.join(ROLES, ro)) or claim_of(os.path.join(ROLES, ro)) is not None]
    if missing:
        raise Refused("missing_roles", "un-archive role(s) %s first; this agent depends on them" % ", ".join(missing),
                      {"missingRoles": missing})
    write_json_atomic(os.path.join(RETURNING, name + ".json"),
                      {"name": name, "ids": [entry["id"]], "accepted_at": time.time()})
    try:
        os.unlink(os.path.join(arch, ".unarchive-refused"))
    except OSError:
        pass
    wake_supervisor()
    log("agent '%s' un-archive accepted%s; the supervisor brings it back"
        % (name, " (waits for its archive to finish)" if still_archiving else ""))
    raise HandedOff()


def do_role_contents(args, entry, save_plan):
    name = check_name(args, pattern=ROLE_RE)
    c = role_contents(name)
    if c is None:
        raise Refused("not_found", "that role doesn't exist or is already archived")
    return c


def do_role_archive(args, entry, save_plan):
    name = check_name(args, pattern=ROLE_RE)
    d = os.path.join(ROLES, name)
    if claim_of(d) is not None:
        return {"role": name, "claimed": [], "already": True}
    if not os.path.isdir(d):
        if os.path.isdir(os.path.join(ROLES_ARCHIVE, name)):
            return {"role": name, "claimed": [], "alreadyArchived": True}
        raise Refused("not_found", "there's no role '%s' on this machine" % name)
    if os.path.exists(os.path.join(ROLES_ARCHIVE, name)):
        raise Refused("archive_slot_taken", "an archived role named '%s' is already in the archive" % name)
    try:
        back = sorted(n[:-5] for n in os.listdir(RETURNING) if n.endswith(".json"))
    except OSError:
        back = []
    for a in back:
        if name in returning_roles(a):
            raise Refused("agent_returning", "'%s' is still being un-archived; try again in a minute" % a)
    current = role_contents(name)
    expected = args.get("expected")
    if expected is not None:
        items = expected.get("agents") if isinstance(expected, dict) else None
        if not isinstance(items, list) or not all(
                isinstance(a, str) or (isinstance(a, dict) and isinstance(a.get("name"), str)) for a in items):
            raise Refused("bad_request", "expected must be {\"agents\": [names]}")
        want = sorted(a["name"] if isinstance(a, dict) else a for a in items)
        if want != sorted(a["name"] for a in current["agents"]):
            raise Refused("contents_changed", "the agents holding this role changed since you looked; check the list again",
                          current)
    agents = [a["name"] for a in current["agents"]]
    refuse_taken_agent_slots(agents)
    for a in agents:
        claim(os.path.join(IDENTITIES, a), entry["id"], "role:%s" % name)
    claim(d, entry["id"], "user" if expected is not None else "note", {"agents": agents})
    wake_supervisor()
    log("role '%s' archive claimed with %d agent(s); the supervisor finishes it" % (name, len(agents)))
    return {"role": name, "claimed": agents}


def do_role_unarchive(args, entry, save_plan):
    name = check_name(args, pattern=ROLE_RE)
    live, arch = os.path.join(ROLES, name), os.path.join(ROLES_ARCHIVE, name)
    if not os.path.isdir(arch):
        if os.path.isdir(live) and claim_of(live) is None:
            return {"role": name, "already": True}
        if os.path.isdir(live):
            raise Refused("still_archiving", "it's still being archived; try again in a minute")
        raise Refused("archive_not_found", "'%s' isn't in the archive" % name)
    if os.path.exists(live):
        raise Refused("name_collision", "a live role named '%s' already exists on this machine" % name)
    for n in (CLAIM, ".unarchive-requested", ".unarchive-refused", ".archive-requested"):
        try:
            os.unlink(os.path.join(arch, n))
        except OSError:
            pass
    os.makedirs(ROLES, exist_ok=True)
    os.rename(arch, live)
    log("role '%s' un-archived" % name)
    return {"role": name}


def do_app_archive(args, entry, save_plan):
    slug = check_name(args, "slug", APP_SLUG_RE, "slug")
    d = os.path.join(APPS, slug)
    if not os.path.isdir(d):
        if os.path.isdir(os.path.join(APPS_ARCHIVE, slug)):
            return {"slug": slug, "alreadyArchived": True}
        where = find_app(slug)
        if where and os.path.realpath(where).startswith(os.path.realpath(PROJECTS) + os.sep):
            raise Refused("project_app", "a project's apps are archived with the project")
        if where:
            raise Refused("conversation_app", "a conversation's apps are archived with the conversation")
        raise Refused("not_found", "there's no app '%s' on this machine" % slug)
    if os.path.exists(os.path.join(APPS_ARCHIVE, slug)):
        raise Refused("archive_slot_taken", "an archived app named '%s' is already in the archive" % slug)
    if not os.path.isfile(ARCHIVE_APP):
        raise Failed("archive_app_missing", "archive-app.sh is missing on this machine")
    with Lock(CREATE_LOCK, "the app create lock"):
        rc, out = run(["bash", ARCHIVE_APP, slug], timeout=90)
    for line in out.splitlines():
        if line.strip():
            log("  archive-app.sh[%s]: %s" % (slug, line))
    if rc != 0:
        tail = [ln for ln in out.splitlines() if ln.strip()]
        raise Failed("archive_failed", tail[-1] if tail else "archive-app.sh failed (%d)" % rc)
    try:
        os.unlink(os.path.join(APPS_ARCHIVE, slug, ".archive-requested"))
    except OSError:
        pass
    return {"slug": slug}


def unit_lines(pattern):
    """Every line of the installed unit files matching `pattern` (a glob in UNIT_DIR)."""
    import glob
    out = set()
    for f in glob.glob(os.path.join(UNIT_DIR, pattern)):
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                out.update(ln.rstrip("\n") for ln in fh)
        except OSError:
            pass
    return out


def start_unarchived_app(slug, live):
    """Put back and start the units of an app whose folder is back in the sidebar. Its saved
    units stay in its folder until it has started, so a failed start can be tried again."""
    sock = os.path.join(live, "app-%s.socket.archived" % slug)
    svc = os.path.join(live, "app-%s.service.archived" % slug)
    if os.path.isfile(sock):
        rc, out = run(["bash", APP_UNITS, "restore", slug, live], timeout=60)
        if rc != 0:
            raise Failed("restore_failed", "it's back but couldn't be started: %s" % (out.strip()[-200:] or rc))
        return
    unit = os.path.join(UNIT_DIR, "app-%s.service" % slug)
    if os.path.isfile(svc):
        import shutil
        os.makedirs(UNIT_DIR, exist_ok=True)
        shutil.copyfile(svc, unit)
    if not os.path.isfile(unit):
        return  # nothing saved and nothing installed: not an app this can start
    run([SYSTEMCTL, "--user", "daemon-reload"])
    rc, out = run([SYSTEMCTL, "--user", "enable", "--now", "app-%s.service" % slug])
    if rc != 0:
        raise Failed("restore_failed", "it's back but couldn't be started: %s" % (out.strip()[-200:] or rc))
    if os.path.isfile(svc):
        os.unlink(svc)


def do_app_unarchive(args, entry, save_plan):
    slug = check_name(args, "slug", APP_SLUG_RE, "slug")
    live, arch = os.path.join(APPS, slug), os.path.join(APPS_ARCHIVE, slug)
    if not os.path.isdir(arch):
        if os.path.isdir(live):
            # Back already — an earlier try whose start failed is finished now.
            if os.path.isfile(os.path.join(live, "app-%s.socket.archived" % slug)) or \
                    os.path.isfile(os.path.join(live, "app-%s.service.archived" % slug)):
                start_unarchived_app(slug, live)
                log("app '%s' un-archive: started it on a later try" % slug)
            return {"slug": slug, "already": True}
        raise Refused("archive_not_found", "'%s' isn't in the archive" % slug)
    if os.path.exists(live):
        raise Refused("name_collision", "a live app named '%s' already exists on this machine" % slug)
    sock = os.path.join(arch, "app-%s.socket.archived" % slug)
    svc = os.path.join(arch, "app-%s.service.archived" % slug)
    if os.path.isfile(sock):
        if os.path.exists(os.path.join(UNIT_DIR, "app-%s.socket" % slug)) or \
                os.path.exists(os.path.join(UNIT_DIR, "app-%s.service" % slug)):
            raise Refused("units_installed", "units for app-%s are already installed" % slug)
        stash, pattern = sock, r"^ListenStream=127\.0\.0\.1:(\d+)$"
    else:
        if os.path.exists(os.path.join(UNIT_DIR, "app-%s.service" % slug)):
            raise Refused("units_installed", "units for app-%s are already installed" % slug)
        if not os.path.isfile(svc):
            raise Refused("no_stash", "its saved units are missing, so its port can't be restored")
        stash, pattern = svc, r"^Environment=PORT=(\d+)$"
    m = None
    with open(stash, encoding="utf-8", errors="replace") as f:
        for ln in f:
            m = m or re.match(pattern, ln.strip())
    if not m:
        raise Refused("no_stash", "its port can't be read from its saved units")
    port = m.group(1)
    with Lock(CREATE_LOCK, "the app create lock"):
        if ("ListenStream=127.0.0.1:%s" % port) in unit_lines("app-*.socket") or \
                ("Environment=PORT=%s" % port) in unit_lines("app-*.service"):
            raise Refused("port_in_use", "its port %s is now used by another app on this machine" % port)
        for n in (".unarchive-requested", ".unarchive-refused", ".archive-requested"):
            try:
                os.unlink(os.path.join(arch, n))
            except OSError:
                pass
        os.makedirs(APPS, exist_ok=True)
        os.rename(arch, live)
    start_unarchived_app(slug, live)
    log("app '%s' un-archived on port %s" % (slug, port))
    return {"slug": slug, "port": int(port)}


HANDLERS = {
    "app-move": do_app_move,
    "project-contents": do_project_contents,
    "project-archive": do_project_archive,
    "agent-archive": do_agent_archive,
    "agent-unarchive": do_agent_unarchive,
    "role-contents": do_role_contents,
    "role-archive": do_role_archive,
    "role-unarchive": do_role_unarchive,
    "app-archive": do_app_archive,
    "app-unarchive": do_app_unarchive,
}


# ---------------------------------------------------------------------------
# The listener
# ---------------------------------------------------------------------------

_stopping = False


def _on_term(signum, frame):
    global _stopping
    _stopping = True
    log("stop asked for — finishing the request in hand first")


def next_seq():
    try:
        with open(SEQ_FILE, encoding="utf-8") as f:
            n = int(f.read().strip() or "1")
    except (OSError, ValueError):
        n = 1
    # Never reuse a number still in the journal.
    for name in list_json(JOURNAL):
        try:
            n = max(n, int(name.split("-", 1)[0]) + 1)
        except ValueError:
            pass
    return n


def known_ids():
    ids = set()
    for name in list_json(JOURNAL):
        i = id_of(name)
        if i:
            ids.add(i)
    ids.update(n[:-5] for n in list_json(BACKGROUND))
    return ids


def take_in():
    """Number every new request in arrival order and move it into the journal."""
    names = list_json(INCOMING)
    if not names:
        return 0
    taken = 0
    in_journal = known_ids()
    seq = next_seq()
    for name in names:
        path = os.path.join(INCOMING, name)
        req = read_json(path)
        rid = req.get("id") if isinstance(req, dict) else None
        if not isinstance(rid, str) or not ID_RE.match(rid):
            log("dropped an unreadable request: %s" % name)
            os.unlink(path)
            continue
        if rid in in_journal or os.path.exists(os.path.join(OUTCOMES, rid + ".json")):
            os.unlink(path)  # the same request sent again
            continue
        kind, args = req.get("kind"), req.get("args")
        if kind not in HANDLERS or not isinstance(args, dict):
            write_json_atomic(os.path.join(OUTCOMES, rid + ".json"), {
                "id": rid, "seq": None, "kind": kind if isinstance(kind, str) else None, "state": "refused",
                "code": "unknown_kind" if kind not in HANDLERS else "bad_request",
                "reason": "this machine doesn't know the request '%s'" % kind if kind not in HANDLERS
                else "args must be an object",
                "finished_at": time.time(),
            })
            os.unlink(path)
            continue
        entry = {"seq": seq, "id": rid, "kind": kind, "args": args,
                 "received_at": req.get("received_at"), "taken_at": time.time(), "state": "queued"}
        write_json_atomic(os.path.join(JOURNAL, "%010d-%s.json" % (seq, rid)), entry)
        os.unlink(path)
        in_journal.add(rid)
        log("request #%d %s %s taken in (id %s)" % (seq, kind, json.dumps(args, separators=(",", ":"))[:300], rid))
        seq += 1
        taken += 1
    write_json_atomic(SEQ_FILE, seq)
    return taken


def carry_out(name):
    path = os.path.join(JOURNAL, name)
    entry = read_json(path)
    if not isinstance(entry, dict):
        log("ERROR: journal entry %s unreadable — dropped" % name)
        os.unlink(path)
        return
    rid = entry["id"]
    out_path = os.path.join(OUTCOMES, rid + ".json")
    if os.path.exists(out_path) or os.path.exists(os.path.join(BACKGROUND, rid + ".json")):
        os.unlink(path)  # finished (or handed off) before a restart; only the clean-up was left
        return
    resumed = entry.get("state") == "running"

    def save_plan(plan):
        entry["plan"] = plan
        write_json_atomic(path, entry)

    outcome = {"id": rid, "seq": entry["seq"], "kind": entry["kind"]}
    t0 = time.time()
    try:
        with Lock(CHANGE_LOCK, "the change lock"):
            # "running" only once it has its turn; until then it's still waiting.
            entry["state"] = "running"
            entry["started_at"] = entry.get("started_at") or time.time()
            write_json_atomic(path, entry)
            result = HANDLERS[entry["kind"]](entry["args"], entry, save_plan)
        outcome.update(state="done", result=result)
    except HandedOff:
        entry["state"] = "finishing"
        entry["handed_off_at"] = time.time()
        write_json_atomic(os.path.join(BACKGROUND, rid + ".json"), entry)
        os.unlink(path)
        log("request #%d %s accepted in %.1fs; finishing in the background" % (entry["seq"], entry["kind"], time.time() - t0))
        return
    except Refused as e:
        outcome.update(state="refused", code=e.code, reason=e.reason)
        if e.result is not None:
            outcome["result"] = e.result
    except Failed as e:
        outcome.update(state="failed", code=e.code, reason=e.reason)
    except Exception as e:  # noqa: BLE001 — every request gets an outcome
        outcome.update(state="failed", code="internal", reason="%s: %s" % (type(e).__name__, e))
    outcome["finished_at"] = time.time()
    write_json_atomic(out_path, outcome)
    os.unlink(path)
    log("request #%d %s %s%s in %.1fs%s" % (
        entry["seq"], entry["kind"], outcome["state"], " (carried on after a restart)" if resumed else "",
        time.time() - t0, (" — %s: %s" % (outcome.get("code"), outcome.get("reason"))) if outcome["state"] != "done" else ""))


def prune():
    cutoff = time.time() - OUTCOME_KEEP_S
    for name in list_json(OUTCOMES):
        p = os.path.join(OUTCOMES, name)
        try:
            if os.stat(p).st_mtime < cutoff:
                os.unlink(p)
        except OSError:
            pass


def serve(until_idle=False):
    ensure_dirs()
    signal.signal(signal.SIGTERM, _on_term)
    signal.signal(signal.SIGINT, _on_term)
    lock_fd = os.open(SERVE_LOCK, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("another listener is already running on this machine — waiting for it to stop")
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
    log("fleet-change listener up (pid %d)" % os.getpid())
    last_prune = 0.0
    while not _stopping:
        try:
            take_in()
            pending = list_json(JOURNAL)
            if pending:
                carry_out(pending[0])
                continue
            if until_idle and not list_json(INCOMING):
                break
            if time.time() - last_prune > PRUNE_EVERY_S:
                prune()
                last_prune = time.time()
        except Exception as e:  # noqa: BLE001 — the listener must keep going
            log("ERROR: %s: %s" % (type(e).__name__, e))
            time.sleep(1)
        time.sleep(POLL_S)
    log("fleet-change listener stopped")


# ---------------------------------------------------------------------------
# The client side
# ---------------------------------------------------------------------------

def where_is(rid):
    """The request's outcome, or how far it has got."""
    outcome = read_json(os.path.join(OUTCOMES, rid + ".json"))
    if isinstance(outcome, dict):
        outcome.pop("finished_at", None)
        res = outcome.get("result")
        if outcome.get("state") == "done" and isinstance(res, dict) and isinstance(res.get("claimed"), list):
            # An archive is done once claimed; its clean-up may still be running.
            f = finishing(res["claimed"], res.get("role") if outcome.get("kind") == "role-archive" else None)
            if f:
                outcome["finishing"] = f
        return outcome
    bg = read_json(os.path.join(BACKGROUND, rid + ".json"))
    if isinstance(bg, dict):
        return {"id": rid, "seq": bg.get("seq"), "kind": bg.get("kind"), "state": "running", "stage": "finishing"}
    journal = list_json(JOURNAL)
    for i, name in enumerate(journal):
        if id_of(name) == rid:
            entry = read_json(os.path.join(JOURNAL, name)) or {}
            return {"id": rid, "seq": entry.get("seq"), "kind": entry.get("kind"),
                    "state": "running" if entry.get("state") == "running" else "queued", "ahead": i}
    for name in list_json(INCOMING):
        if id_of(name) == rid:
            return {"id": rid, "state": "received"}
    return None


def wait_for(rid, wait_s):
    deadline = time.time() + wait_s
    while True:
        w = where_is(rid)
        if w is not None and w["state"] in ("done", "refused", "failed"):
            return w
        if time.time() >= deadline:
            return w or {"id": rid, "state": "unknown"}
        time.sleep(POLL_S)


def usage(msg=None):
    if msg:
        sys.stderr.write("fleet-change: %s\n" % msg)
    sys.stderr.write(__doc__.split("Usage:", 1)[1].split("Output", 1)[0])
    sys.exit(2)


def parse_wait(argv, default):
    if "--wait" not in argv:
        return default
    i = argv.index("--wait")
    try:
        w = float(argv[i + 1])
    except (IndexError, ValueError):
        usage("--wait needs a number of seconds")
    del argv[i:i + 2]
    return max(0.0, min(w, MAX_WAIT_S))


def submit(argv):
    wait_s = parse_wait(argv, DEFAULT_WAIT_S)
    rid = None
    if "--id" in argv:
        i = argv.index("--id")
        if i + 1 >= len(argv):
            usage("--id needs a value")
        rid = argv[i + 1]
        del argv[i:i + 2]
        if not ID_RE.match(rid):
            usage("--id must match [A-Za-z0-9._-]{1,80}")
    if len(argv) != 2:
        usage("submit takes a kind and its args as JSON")
    kind, raw = argv
    if kind not in KINDS:
        usage("unknown kind '%s' (known: %s)" % (kind, ", ".join(KINDS)))
    try:
        args = json.loads(raw)
    except ValueError as e:
        usage("args aren't valid JSON: %s" % e)
    if not isinstance(args, dict):
        usage("args must be a JSON object")
    rid = rid or str(uuid.uuid4())
    ensure_dirs()
    if where_is(rid) is None:
        write_json_atomic(os.path.join(INCOMING, "%020d-%s.json" % (time.time_ns(), rid)),
                          {"id": rid, "kind": kind, "args": args, "received_at": time.time()})
    print(json.dumps(wait_for(rid, wait_s), separators=(",", ":")))


def status(argv):
    wait_s = parse_wait(argv, 0.0)
    if len(argv) != 1 or not ID_RE.match(argv[0]):
        usage("status takes one request id")
    print(json.dumps(wait_for(argv[0], wait_s), separators=(",", ":")))


def finish(argv):
    """fleet-change finish <id> done|refused|failed [--code C] [--reason R] [--result JSON]
    The outcome of a request that was finished in the background."""
    opts = {}
    for key in ("--code", "--reason", "--result"):
        if key in argv:
            i = argv.index(key)
            if i + 1 >= len(argv):
                usage("%s needs a value" % key)
            opts[key[2:]] = argv[i + 1]
            del argv[i:i + 2]
    if len(argv) != 2 or not ID_RE.match(argv[0]) or argv[1] not in ("done", "refused", "failed"):
        usage("finish takes a request id and done|refused|failed")
    rid, state = argv
    out_path = os.path.join(OUTCOMES, rid + ".json")
    bg_path = os.path.join(BACKGROUND, rid + ".json")
    if os.path.exists(out_path):
        print(json.dumps(where_is(rid), separators=(",", ":")))
        return
    bg = read_json(bg_path)
    if not isinstance(bg, dict):
        usage("there's no request %s being finished in the background" % rid)
    outcome = {"id": rid, "seq": bg.get("seq"), "kind": bg.get("kind"), "state": state}
    if state != "done":
        outcome["code"] = opts.get("code") or state
        outcome["reason"] = opts.get("reason") or ""
    if "result" in opts:
        try:
            outcome["result"] = json.loads(opts["result"])
        except ValueError:
            usage("--result isn't valid JSON")
    outcome["finished_at"] = time.time()
    ensure_dirs()
    write_json_atomic(out_path, outcome)
    os.unlink(bg_path)
    print(json.dumps(where_is(rid), separators=(",", ":")))


def hold_lock(argv):
    if len(argv) != 2 or argv[0] != "--parent" or not argv[1].isdigit():
        usage("hold-lock takes --parent <pid>")
    parent = int(argv[1])
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    with Lock(CHANGE_LOCK, "the change lock"):
        print("held", flush=True)
        while True:
            try:
                os.kill(parent, 0)
            except ProcessLookupError:
                break
            except PermissionError:
                pass
            time.sleep(0.2)


def main():
    argv = sys.argv[1:]
    if not argv:
        usage()
    cmd, rest = argv[0], argv[1:]
    if cmd == "submit":
        submit(rest)
    elif cmd == "status":
        status(rest)
    elif cmd == "serve":
        if rest not in ([], ["--until-idle"]):
            usage("serve takes no arguments but --until-idle")
        serve(until_idle=bool(rest))
    elif cmd == "hold-lock":
        hold_lock(rest)
    elif cmd == "finish":
        finish(rest)
    elif cmd == "kinds":
        print(json.dumps({"kinds": list(KINDS)}))
    else:
        usage("unknown command '%s'" % cmd)


if __name__ == "__main__":
    main()
